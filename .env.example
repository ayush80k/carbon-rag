# ============================================================
# Carbon RAG AI - Environment Variables Example
# ============================================================

# Google Gemini API key
# Get your API key from Google AI Studio
GOOGLE_API_KEY=your_google_gemini_api_key_here


# Pinecone API key
PINECONE_API_KEY=your_pinecone_api_key_here


# Pinecone index name
# This must match the index you created in your Pinecone dashboard.
PINECONE_INDEX=carbon-knowledge


# Server port
# Use 3000 if your frontend/API requests point to localhost:3000
PORT=3000


# Optional application port.
# If APP_PORT is present, the current api.ts gives it priority over PORT.
# APP_PORT=3000